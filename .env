# Backend target for Vite dev proxy (FastAPI server address)
VITE_API_PROXY_TARGET=http://localhost:8000

# Base URL for frontend API requests
VITE_API_BASE_URL=/api

# ─── Affiliate ───
# Bật/tắt mở tab affiliate khi người dùng bấm "Bắt đầu xử lý" hợp lệ
VITE_AFFILIATE_ENABLED=false
# URL affiliate duy nhất (để trống = bỏ qua, KHÔNG dùng URL mẫu trong production)
VITE_AFFILIATE_URL=

# ─── Google AdSense ───
# Chỉ bật sau khi tài khoản AdSense đã được phê duyệt & xác minh site
VITE_ADSENSE_ENABLED=false
# Publisher ID thật từ AdSense (dạng ca-pub-XXXXXXXXXXXXXXXX) - không dùng giá trị giả
VITE_ADSENSE_CLIENT=

# ─── Adsterra (URL nằm trong src/config/ads.ts, KHÔNG đổi URL/ID) ───
# Smartlink: CTA "Khám phá ưu đãi" ta tự vẽ, chỉ mở khi người dùng nhấn.
VITE_ADS_SMARTLINK_ENABLED=false
# Social Bar: script bên thứ ba chèn thanh của nó vào document; chỉ nạp khi user
# KHÔNG thuộc gói Pro và ĐÃ đồng ý cookie "quảng cáo" (Consent > advertising).
VITE_ADS_SOCIALBAR_ENABLED=false
# Popunder: MẶC ĐỊNH TẮT. Script bind click/mousedown/touchstart ở mức document
# (đo 10/2026) nên mọi cú nhấn Download/Start Processing đều là trigger mở tab.
# Chỉ bật sau khi chủ site xác nhận chính sách mạng quảng cáo và hành vi trên domain thật.
VITE_ADS_POPUNDER_ENABLED=false

# ─── Supabase Auth (Google OAuth + email OTP) ───
# Anon key là public (bảo vệ bởi RLS) — lấy từ Project Settings > API.
# Google OAuth bật trong Authentication > Providers; URL redirect cấu hình trên Supabase.
VITE_SUPABASE_URL=https://igazakslconjtkufpgwo.supabase.co
