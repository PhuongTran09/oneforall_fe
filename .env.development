# Development Environment
# Vite Dev Proxy Target (FastAPI backend)
VITE_API_PROXY_TARGET=http://localhost:8000

# Base URL for frontend API requests (relative path forward to dev proxy)
VITE_API_BASE_URL=/api

# Affiliate (tắt mặc định - xem .env.example để biết cách bật)
VITE_AFFILIATE_ENABLED=false
VITE_AFFILIATE_URL=

# Google AdSense (tắt mặc định - chỉ bật sau khi được phê duyệt)
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_CONTENT=
VITE_ADSENSE_SLOT_BOTTOM=
