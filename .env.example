# Backend target for Vite dev proxy (FastAPI server address)
VITE_API_PROXY_TARGET=http://localhost:8000

# Base URL for frontend API requests
VITE_API_BASE_URL=/api

# ─── Affiliate ───
# Bật/tắt mở tab affiliate khi người dùng bấm "Bắt đầu xử lý" hợp lệ
VITE_AFFILIATE_ENABLED=false
# URL affiliate duy nhất (để trống = bỏ qua, KHÔNG dùng URL mẫu trong production)
VITE_AFFILIATE_URL=

# ─── Google AdSense ───
# Chỉ bật sau khi tài khoản AdSense đã được phê duyệt & xác minh site
VITE_ADSENSE_ENABLED=false
# Publisher ID thật từ AdSense (dạng ca-pub-XXXXXXXXXXXXXXXX) - không dùng giá trị giả
VITE_ADSENSE_CLIENT=

# ─── Adsterra (URL đọc từ env; để trống URL = định dạng đó TẮT kể cả khi cờ bật) ───
# Đây là link publisher, không phải secret (đã nằm công khai trong bundle), nhưng đổi
# URL/ID là đổi đối tượng thống kê của publisher — sửa có chủ đích, đừng tái tạo.
# Smartlink: KHÔNG có block quảng cáo nào trên trang; tự mở 1 tab khi người dùng bấm
# "Bắt đầu xử lý"/"Bắt đầu tải" hợp lệ (cooldown 5s; popup-blocker chặn thì thôi,
# luồng xử lý vẫn chạy). Chỉ mở cho user không Pro và đã đồng ý cookie "quảng cáo".
VITE_ADS_SMARTLINK_ENABLED=false
VITE_ADS_SMARTLINK_URL=https://auctionr.org/4/c82d1249e94901fde16ea842607a4c49
# Social Bar: script bên thứ ba chèn thanh của nó vào document; chỉ nạp khi user
# KHÔNG thuộc gói Pro và ĐÃ đồng ý cookie "quảng cáo" (Consent > advertising).
VITE_ADS_SOCIALBAR_ENABLED=false
VITE_ADS_SOCIALBAR_SRC=https://bauval.org/14/df18540f90166bd46c1f22815c909389
# Popunder: ĐÓNG CỜ NÀY KHÔNG BẬT ĐƯỢC GÌ — code không còn điểm nạp popunder.
# Script của nó bind click/mousedown/touchstart ở mức document (đo 10/2026) nên mọi
# cú nhấn trong trang đều là trigger mở tab. Muốn dùng phải cố tình viết lại điểm nạp
# sau khi chủ site xác nhận chính sách mạng quảng cáo + hành vi trên domain thật.
VITE_ADS_POPUNDER_ENABLED=false
VITE_ADS_POPUNDER_SRC=https://abscloud.org/1/19969e1bfc84e619ca2e34966319c39a

# ─── Supabase Auth (email+password, email OTP, Google OAuth) ───
# Anon key là public (bảo vệ bởi RLS) — lấy từ Project Settings > API.
# Cần cấu hình trong Supabase Dashboard:
#   - Authentication > Providers: Email (bật "Confirm email" nếu muốn luồng OTP 6 số).
#   - Authentication > URL Configuration: Site URL = https://oneforall.io.vn và
#     thêm Redirect URLs: https://oneforall.io.vn/auth/reset-password,
#     http://localhost:5173/auth/reset-password (dev), cùng bản /en/... nếu dùng EN.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Cloudflare Turnstile (chống spam anonymous — nối tiếp GĐ1/GĐ2 của BE) ───
# Site key là PUBLIC (widget render phía browser). Secret key nằm ở BE (.env
# TURNSTILE_SECRET_KEY), KHÔNG bao giờ đưa vào bundle FE.
# VITE_TURNSTILE_SITE_KEY= -> lấy ở Cloudflare Dashboard > Turnstile > Manage > Site Key
# Cờ BẬT khi nào? Khi BE bật ANON_CAPTCHA_ENABLED và code FE đã nạp widget: BE khai báo
# "phiên này phải giải ải" bằng field `captcha_required` trong response của
# POST /v1/anonymous/session (mặc định BE ANON_CAPTCHA_TRIGGER_JOBS=0 => hỏi từ job ẩn danh
# ĐẦU TIÊN), FE giải TRƯỚC khi gửi job và gắn token vào field "cf_token" (form-data hoặc JSON
# body — xem app/api/v1/endpoints/image.py phía BE); luồng dự phòng vẫn còn: gặp 403
# {"code":"captcha_required"} thì mở panel rồi retry một lần.
# BUILD SẢN PHẨM PHẢI BẬT HAI DÒNG DƯỚI: BE hỏi mà FE không có site key thì request chết ngay
# với "captcha.unavailable" — mọi job ẩn danh fail-closed, không phải bug.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
