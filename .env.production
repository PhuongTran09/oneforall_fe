# Production Environment
# In production, Vite proxy is not used.
# Frontend is served statically and requests /api are typically forwarded by Nginx/Caddy reverse proxy
# or this variable can point to a production API domain.
VITE_API_BASE_URL=/api

# Affiliate (tắt mặc định - xem .env.example để biết cách bật)
VITE_AFFILIATE_ENABLED=false
VITE_AFFILIATE_URL=

# Google AdSense (tắt mặc định - chỉ bật sau khi được phê duyệt)
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_CONTENT=
VITE_ADSENSE_SLOT_BOTTOM=
