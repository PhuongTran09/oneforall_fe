# Production Environment
# In production, Vite proxy is not used. Frontend on Cloudflare Pages calls the
# FastAPI backend directly, so this must be the absolute backend URL INCLUDING
# the /api prefix (backend routes live under https://api.oneforall.io.vn/api/v1/...).
# VITE_* from Cloudflare Pages env (build time) overrides this file — keep both in sync.
VITE_API_BASE_URL=https://api.oneforall.io.vn/api

# Affiliate (tắt mặc định - xem .env.example để biết cách bật)
VITE_AFFILIATE_ENABLED=false


# Google AdSense (tắt mặc định - chỉ bật sau khi được phê duyệt)
VITE_ADSENSE_ENABLED=false

